# ===========================================
# Backend Environment Variables (.env.example)
# Copy this file to .env and fill in values
# ===========================================

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/taskmanager
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
DATABASE_URL=

# JWT Secret (used for token signing — generate a strong random string)
JWT_SECRET=

# Groq AI API Key (https://console.groq.com/keys)
GROQ_API_KEY=

# Gmail SMTP Configuration (for email notifications)
GMAIL_USER=your_email@gmail.com
# Get a 16-char App Password from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Server Port
PORT=5000

# Frontend URL (for CORS — set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Node Environment (set to 'production' on deployment platform)
NODE_ENV=development
